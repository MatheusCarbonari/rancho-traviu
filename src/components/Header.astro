---
const navigationItems = [
	{ label: 'Início', href: '/' },
	{ label: 'O Rancho', href: '/o-rancho' },
	{ label: 'Cardápio', href: '/cardapio' },
	{ label: 'Sua Visita', href: '/sua-visita' },
] as const;

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="site-header">
	<div class="site-header__inner">
		<a class="site-header__brand" href="/" aria-label="Rancho Traviú — início">
			Rancho Traviú
		</a>

		<nav aria-label="Navegação principal">
			<ul>
				{
					navigationItems.map(({ label, href }) => (
						<li>
							<a
								href={href}
								aria-current={currentPath === href ? 'page' : undefined}
							>
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 0.25rem solid #936544;
		background: #344b36;
		color: #eee5d3;
		font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
	}

	.site-header__inner {
		display: flex;
		width: min(100%, 72rem);
		margin: 0 auto;
		padding: 0.65rem 0.75rem;
		flex-direction: column;
		gap: 0.35rem;
	}

	.site-header__brand {
		align-self: center;
		color: inherit;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.4rem;
		line-height: 1.2;
		text-decoration: none;
	}

	nav ul {
		display: grid;
		margin: 0;
		padding: 0;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.125rem;
		list-style: none;
	}

	nav a {
		display: flex;
		min-height: 2.75rem;
		padding: 0.6rem 0.25rem;
		align-items: center;
		justify-content: center;
		border-radius: 0.2rem;
		color: inherit;
		font-size: 0.875rem;
		font-weight: 600;
		line-height: 1.2;
		text-align: center;
		text-decoration: none;
		white-space: nowrap;
	}

	nav a[aria-current="page"] {
		background: #eee5d3;
		color: #344b36;
	}

	a:focus-visible {
		outline: 0.125rem solid #eee5d3;
		outline-offset: 0.2rem;
	}

	@media (hover: hover) {
		nav a:hover:not([aria-current="page"]) {
			background: color-mix(in srgb, #eee5d3 14%, transparent);
		}
	}

	@media (min-width: 48rem) {
		.site-header__inner {
			min-height: 5rem;
			padding: 0.75rem clamp(2rem, 6vw, 6rem);
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			gap: 2rem;
		}

		.site-header__brand {
			align-self: auto;
			white-space: nowrap;
		}

		nav ul {
			display: flex;
			flex-wrap: wrap;
			justify-content: flex-end;
		}

		nav a {
			padding-inline: 0.75rem;
		}
	}
</style>
