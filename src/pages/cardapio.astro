];
---

<BaseLayout
	title="Cardápio | Rancho Traviú"
	description="Conheça o cardápio do Rancho Traviú, com refeições, porções e bebidas."
>
	<div class="menu-page">
		<section class="menu-intro" aria-labelledby="menu-title">
			<div class="menu-intro__inner">
				<div class="menu-intro__content">
					<p class="menu-intro__eyebrow">Sabores do Rancho</p>
					<h1 id="menu-title">Nosso Cardápio</h1>
					<p class="menu-intro__description">
						Comida caseira, tradição e o sabor especial do fogão a lenha.
					</p>
				</div>

				<figure class="menu-intro__media">
					<Image
						src={menuStoveImage}
						alt="Imagem ilustrativa de panelas com comida caseira preparadas sobre um fogão a lenha em ambiente rústico."
						class="menu-intro__image"
						layout="full-width"
						sizes="(min-width: 80rem) 34rem, (min-width: 48rem) 42vw, calc(100vw - 2.5rem)"
						priority
					/>
				</figure>
			</div>
		</section>

		<section class="menu-catalog" aria-label="Cardápio do Rancho Traviú">
			<div class="menu-catalog__inner">
				<div class="menu-columns menu-columns--mobile">
					{
						menuColumns.map((column) => (
							<section class="menu-column">
								<h2>{column.title}</h2>
								<div class="menu-groups">
									{column.categories.map((category) => (
										<details class="menu-group" open={category.initiallyOpen}>
											<summary>
												<span>{category.title}</span>
												<span class="menu-group__indicator" aria-hidden="true">+</span>
											</summary>
											<ul class="menu-products">
												{category.items.map((item) => (
													<li class="menu-product">
														<span class="menu-product__name">{item.name}</span>
														<span class="menu-product__prices">
															{item.price && (
																item.price.value ? (
																	<data value={item.price.value}>{item.price.label}</data>
																) : (
																	<span>{item.price.label}</span>
																)
															)}
															{item.whole && (
																<span class="menu-product__option">
																	<span>Inteira</span>
																	<data value={item.whole.value}>{item.whole.label}</data>
																</span>
															)}
															{item.half && (
																<span class="menu-product__option">
																	<span>Meia</span>
																	<data value={item.half.value}>{item.half.label}</data>
																</span>
															)}
														</span>
													</li>
												))}
											</ul>
										</details>
									))}
								</div>
							</section>
						))
					}
				</div>

				<div class="menu-columns menu-columns--desktop">
					{
						menuColumns.map((column) => (
							<section class="menu-column">
								<h2>{column.title}</h2>
								<div class="menu-groups">
									{column.categories.map((category) => (
										<section class="menu-group menu-group--static">
											<h3>{category.title}</h3>
											<ul class="menu-products">
												{category.items.map((item) => (
													<li class="menu-product">
														<span class="menu-product__name">{item.name}</span>
														<span class="menu-product__prices">
															{item.price && (
																item.price.value ? (
																	<data value={item.price.value}>{item.price.label}</data>
																) : (
																	<span>{item.price.label}</span>
																)
															)}
															{item.whole && (
																<span class="menu-product__option">
																	<span>Inteira</span>
																	<data value={item.whole.value}>{item.whole.label}</data>
																</span>
															)}
															{item.half && (
																<span class="menu-product__option">
																	<span>Meia</span>
																	<data value={item.half.value}>{item.half.label}</data>
																</span>
															)}
														</span>
													</li>
												))}
											</ul>
										</section>
									))}
								</div>
							</section>
						))
					}
				</div>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.menu-page {
		--menu-forest: #344b36;
		--menu-cream: #eee5d3;
		--menu-wood: #936544;
		--menu-terracotta: #a65f46;

		background: var(--menu-cream);
		color: var(--menu-forest);
		font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
	}

	.menu-intro {
		padding: clamp(3.5rem, 12vw, 6rem) clamp(1.25rem, 6vw, 6rem);
		border-bottom: 1px solid
			color-mix(in srgb, var(--menu-wood) 30%, transparent);
		background: linear-gradient(
			145deg,
			color-mix(in srgb, var(--menu-forest) 5%, var(--menu-cream)),
			var(--menu-cream)
		);
	}

	.menu-intro__inner,
	.menu-catalog__inner {
		width: min(100%, 72rem);
		margin: 0 auto;
	}

	.menu-intro__eyebrow {
		margin: 0 0 1rem;
		color: #765033;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.menu-intro h1,
	.menu-column h2,
	.menu-group summary,
	.menu-group--static h3,
	.menu-product__name {
		font-family: Georgia, "Times New Roman", serif;
	}

	.menu-intro h1 {
		max-width: 11ch;
		margin: 0;
		font-size: clamp(3rem, 13vw, 5.5rem);
		font-weight: 400;
		letter-spacing: -0.045em;
		line-height: 0.98;
	}

	.menu-intro__content {
		max-width: 34rem;
	}

	.menu-intro__description {
		margin: 1.75rem 0 0;
		font-size: clamp(1.1rem, 4vw, 1.35rem);
		line-height: 1.65;
	}

	.menu-intro__media {
		position: relative;
		width: 100%;
		aspect-ratio: 3 / 2;
		margin: 2rem 0 0;
		overflow: hidden;
		border: 1px solid
			color-mix(in srgb, var(--menu-forest) 28%, transparent);
		border-radius: 0.25rem 1.25rem 0.25rem 1.25rem;
		background: color-mix(in srgb, var(--menu-wood) 14%, var(--menu-cream));
	}

	.menu-intro__media :global(.menu-intro__image) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.menu-catalog {
		padding: clamp(3rem, 9vw, 5.5rem) clamp(1.25rem, 6vw, 6rem);
		background: color-mix(in srgb, var(--menu-wood) 5%, var(--menu-cream));
	}

	.menu-columns {
		display: grid;
		gap: 3rem;
	}

	.menu-columns--desktop {
		display: none;
	}

	.menu-column h2 {
		margin: 0 0 1.5rem;
		padding-left: 1rem;
		border-left: 0.25rem solid var(--menu-terracotta);
		font-size: clamp(2rem, 9vw, 3rem);
		font-weight: 400;
		letter-spacing: -0.025em;
		line-height: 1.05;
	}

	.menu-groups {
		display: grid;
		gap: 0.75rem;
	}

	.menu-group {
		border: 1px solid color-mix(in srgb, var(--menu-wood) 32%, transparent);
		border-radius: 0.25rem 0.9rem 0.25rem 0.9rem;
		background: color-mix(in srgb, var(--menu-cream) 88%, white);
	}

	.menu-group summary {
		display: flex;
		min-height: 2.75rem;
		padding: 0.75rem 1rem;
		justify-content: space-between;
		gap: 1rem;
		align-items: center;
		color: var(--menu-forest);
		font-size: 1.05rem;
		font-weight: 700;
		line-height: 1.3;
		list-style: none;
		cursor: pointer;
	}

	.menu-group summary::-webkit-details-marker {
		display: none;
	}

	.menu-group summary:focus-visible {
		outline: 0.1875rem solid #7d4331;
		outline-offset: 0.15rem;
	}

	.menu-group__indicator {
		color: #7d4331;
		font-family: system-ui, sans-serif;
		font-size: 1.35rem;
		font-weight: 400;
		line-height: 1;
	}

	.menu-group[open] .menu-group__indicator {
		transform: rotate(45deg);
	}

	.menu-products {
		margin: 0;
		padding: 0 1rem 0.35rem;
		border-top: 1px solid
			color-mix(in srgb, var(--menu-wood) 24%, transparent);
		list-style: none;
	}

	.menu-product {
		display: grid;
		padding: 0.75rem 0;
		gap: 0.4rem;
	}

	.menu-product + .menu-product {
		border-top: 1px solid
			color-mix(in srgb, var(--menu-wood) 24%, transparent);
	}

	.menu-product__name {
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.35;
	}

	.menu-product__prices {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.9rem;
		align-items: baseline;
		color: #7d4331;
		font-size: 0.875rem;
		font-weight: 700;
		line-height: 1.4;
	}

	.menu-product__prices data {
		white-space: nowrap;
	}

	.menu-product__option {
		display: inline-flex;
		gap: 0.3rem;
		align-items: baseline;
	}

	.menu-product__option > span {
		color: color-mix(in srgb, var(--menu-forest) 82%, transparent);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	@media (min-width: 48rem) {
		.menu-intro {
			padding-block: clamp(4rem, 6vw, 5rem);
		}

		.menu-intro__inner {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: clamp(3rem, 6vw, 5rem);
			align-items: center;
		}

		.menu-intro__media {
			margin-top: 0;
		}

	}

	@media (min-width: 64rem) {
		.menu-columns--mobile {
			display: none;
		}

		.menu-columns--desktop {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: clamp(2.5rem, 5vw, 5rem);
			align-items: start;
		}

		.menu-column h2 {
			margin-bottom: 2rem;
			font-size: clamp(2.25rem, 4vw, 3.25rem);
		}

		.menu-groups {
			gap: 1.75rem;
		}

		.menu-group--static {
			border: 0;
			border-radius: 0;
			background: transparent;
		}

		.menu-group--static h3 {
			margin: 0;
			padding-bottom: 0.65rem;
			border-bottom: 0.125rem solid var(--menu-terracotta);
			font-size: 1.15rem;
			font-weight: 700;
			line-height: 1.3;
		}

		.menu-group--static .menu-products {
			padding: 0;
			border-top: 0;
		}

		.menu-product {
			grid-template-columns: minmax(0, 1fr) auto;
			padding-block: 0.65rem;
			column-gap: 1rem;
			align-items: baseline;
		}

		.menu-product__prices {
			justify-content: flex-end;
			text-align: right;
		}
	}
</style>
