	label: string;
	value?: string;
};

type MenuProduct = {
	name: string;
	price?: Price;
	whole?: Price;
	half?: Price;
};

type MenuCategory = {
	title: string;
	initiallyOpen?: boolean;
	items: MenuProduct[];
};

