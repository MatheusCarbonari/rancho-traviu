---
import { Image } from 'astro:assets';
import menuStoveImage from '../assets/images/Pagina_Cardapio_Fogao.png';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Cardápio | Rancho Traviú"
	description="Conheça uma demonstração do cardápio do Rancho Traviú, com comida caseira e sabores do fogão a lenha."
>
	<div class="menu-page">
		<section class="menu-intro" aria-labelledby="menu-title">
			<div class="menu-intro__inner">
				<div class="menu-intro__content">
					<p class="menu-intro__eyebrow">Sabores do Rancho</p>
					<h1 id="menu-title">Nosso Cardápio</h1>
					<p class="menu-intro__description">
						Comida caseira, tradição e o sabor especial do fogão a lenha.
					</p>
					<p class="menu-intro__notice">
						Cardápio demonstrativo — itens e preços ilustrativos.
					</p>
				</div>

				<figure class="menu-intro__media">
					<Image
						src={menuStoveImage}
						alt="Imagem ilustrativa de panelas com comida caseira preparadas sobre um fogão a lenha em ambiente rústico."
						class="menu-intro__image"
						layout="full-width"
						priority
					/>
					<figcaption>Imagem ilustrativa</figcaption>
				</figure>
			</div>
		</section>

		<section class="menu-category" aria-labelledby="all-you-can-eat-title">
			<div class="menu-category__inner">
				<header class="menu-category__heading menu-category__heading--priced">
					<div>
						<p class="menu-category__eyebrow">Sabores tradicionais</p>
						<h2 id="all-you-can-eat-title">Coma à vontade</h2>
					</div>

					<p class="menu-category__price">
						<data value="69.90">R$ 69,90</data>
						<span>por pessoa</span>
					</p>
				</header>

				<ul class="menu-list menu-list--included">
					<li class="menu-item">
						<div class="menu-item__heading">
							<h3>Frango caipira</h3>
						</div>
						<p>
							Preparado lentamente, com tempero caseiro e sabor de comida feita
							no Rancho.
						</p>
					</li>

					<li class="menu-item">
						<div class="menu-item__heading">
							<h3>Costela suína</h3>
						</div>
						<p>
							Macia e bem temperada, com o sabor acolhedor da cozinha do campo.
						</p>
					</li>

					<li class="menu-item">
						<div class="menu-item__heading">
							<h3>Carne de panela</h3>
						</div>
						<p>
							Cozida devagar, macia e com o sabor tradicional da comida caseira.
						</p>
					</li>

					<li class="menu-item">
						<div class="menu-item__heading">
							<h3>Arroz e feijão</h3>
						</div>
						<p>Acompanhamentos clássicos da comida caseira do dia a dia.</p>
					</li>
				</ul>
			</div>
		</section>

		<section
			class="menu-category menu-category--sides"
			aria-labelledby="sides-title"
		>
			<div class="menu-category__inner">
				<header class="menu-category__heading">
					<p class="menu-category__eyebrow">Pedidos separados</p>
					<h2 id="sides-title">Porções à parte</h2>
				</header>

				<ul class="menu-list">
					<li class="menu-item">
						<div class="menu-item__heading">
							<h3>Batata frita</h3>
							<data value="45.00">R$ 45,00</data>
						</div>
						<p>Porção dourada e crocante para acompanhar a refeição.</p>
					</li>

					<li class="menu-item">
						<div class="menu-item__heading">
							<h3>Mandioca frita</h3>
							<data value="32.00">R$ 32,00</data>
						</div>
						<p>Mandioca dourada por fora e macia por dentro.</p>
					</li>

					<li class="menu-item">
						<div class="menu-item__heading">
							<h3>Torresmo</h3>
							<data value="38.00">R$ 38,00</data>
						</div>
						<p>Porção crocante, preparada ao estilo caseiro.</p>
					</li>
				</ul>
			</div>
		</section>

		<section class="menu-category" aria-labelledby="drinks-title">
			<div class="menu-category__inner">
				<header class="menu-category__heading">
					<p class="menu-category__eyebrow">Para acompanhar</p>
					<h2 id="drinks-title">Bebidas</h2>
				</header>

				<ul class="menu-list">
					<li class="menu-item">
						<div class="menu-item__heading">
							<h3>Cerveja 600 ml</h3>
							<data value="18.00">R$ 18,00</data>
						</div>
						<p>Cerveja bem gelada para acompanhar os bons momentos.</p>
					</li>

					<li class="menu-item">
						<div class="menu-item__heading">
							<h3>Refrigerante lata</h3>
							<data value="7.00">R$ 7,00</data>
						</div>
						<p>Lata de 350 ml, servida gelada.</p>
					</li>

					<li class="menu-item">
						<div class="menu-item__heading">
							<h3>Suco natural</h3>
							<data value="10.00">R$ 10,00</data>
						</div>
						<p>Suco preparado com frutas, conforme disponibilidade.</p>
					</li>

					<li class="menu-item">
						<div class="menu-item__heading">
							<h3>Água mineral</h3>
							<data value="5.00">R$ 5,00</data>
						</div>
						<p>Garrafa de 500 ml.</p>
					</li>
				</ul>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.menu-page {
		--menu-forest: #344b36;
		--menu-cream: #eee5d3;
		--menu-wood: #936544;
		--menu-terracotta: #a65f46;

		background: var(--menu-cream);
		color: var(--menu-forest);
		font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
	}

	.menu-intro {
		padding: clamp(3.5rem, 12vw, 6rem) clamp(1.25rem, 6vw, 6rem);
		border-bottom: 1px solid
			color-mix(in srgb, var(--menu-wood) 30%, transparent);
		background: linear-gradient(
			145deg,
			color-mix(in srgb, var(--menu-forest) 5%, var(--menu-cream)),
			var(--menu-cream)
		);
	}

	.menu-intro__inner,
	.menu-category__inner {
		width: min(100%, 72rem);
		margin: 0 auto;
	}

	.menu-intro__eyebrow,
	.menu-category__eyebrow {
		margin: 0 0 1rem;
		color: var(--menu-wood);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.menu-intro h1,
	.menu-category h2,
	.menu-item h3 {
		font-family: Georgia, "Times New Roman", serif;
	}

	.menu-intro h1 {
		max-width: 11ch;
		margin: 0;
		font-size: clamp(3rem, 13vw, 5.5rem);
		font-weight: 400;
		letter-spacing: -0.045em;
		line-height: 0.98;
	}

	.menu-intro__content {
		max-width: 34rem;
	}

	.menu-intro__description {
		margin: 1.75rem 0 0;
		font-size: clamp(1.1rem, 4vw, 1.35rem);
		line-height: 1.65;
	}

	.menu-intro__notice {
		margin: 1.75rem 0 0;
		padding: 0.9rem 1rem;
		border-left: 0.25rem solid var(--menu-terracotta);
		background: color-mix(in srgb, var(--menu-wood) 10%, transparent);
		font-size: 0.85rem;
		line-height: 1.55;
	}

	.menu-intro__media {
		position: relative;
		width: 100%;
		aspect-ratio: 3 / 2;
		margin: 2rem 0 0;
		overflow: hidden;
		border: 1px solid
			color-mix(in srgb, var(--menu-forest) 28%, transparent);
		border-radius: 0.25rem 1.25rem 0.25rem 1.25rem;
		background: color-mix(in srgb, var(--menu-wood) 14%, var(--menu-cream));
	}

	.menu-intro__media :global(.menu-intro__image) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.menu-intro__media figcaption {
		position: absolute;
		right: 1rem;
		bottom: 1rem;
		padding: 0.45rem 0.65rem;
		background: var(--menu-cream);
		color: var(--menu-forest);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.menu-category {
		padding: clamp(4rem, 12vw, 7rem) clamp(1.25rem, 6vw, 6rem);
	}

	.menu-category__inner {
		max-width: 58rem;
	}

	.menu-category__heading {
		padding-left: 1.25rem;
		border-left: 0.25rem solid var(--menu-terracotta);
	}

	.menu-category__eyebrow {
		margin-bottom: 0.65rem;
		color: var(--menu-terracotta);
	}

	.menu-category__price {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		margin: 1.5rem 0 0;
		color: var(--menu-terracotta);
	}

	.menu-category__price data {
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(2rem, 8vw, 3rem);
		line-height: 1;
	}

	.menu-category__price span {
		margin-top: 0.4rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.menu-category h2 {
		margin: 0;
		font-size: clamp(2.25rem, 9vw, 4rem);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 1.05;
	}

	.menu-list {
		margin: clamp(2.5rem, 8vw, 4rem) 0 0;
		padding: 0;
		border-top: 1px solid
			color-mix(in srgb, var(--menu-wood) 38%, transparent);
		list-style: none;
	}

	.menu-list--included .menu-item__heading {
		display: block;
	}

	.menu-category--sides {
		border-top: 1px solid
			color-mix(in srgb, var(--menu-wood) 30%, transparent);
		background: color-mix(in srgb, var(--menu-wood) 7%, var(--menu-cream));
	}

	.menu-item {
		padding: 1.5rem 0;
		border-bottom: 1px solid
			color-mix(in srgb, var(--menu-wood) 30%, transparent);
	}

	.menu-item__heading {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		gap: 1rem;
		align-items: baseline;
	}

	.menu-item h3 {
		margin: 0;
		font-size: clamp(1.3rem, 5vw, 1.65rem);
		font-weight: 400;
		line-height: 1.2;
	}

	.menu-item data {
		color: var(--menu-terracotta);
		font-size: 1rem;
		font-weight: 700;
		line-height: 1.4;
		white-space: nowrap;
	}

	.menu-item > p {
		max-width: 42rem;
		margin: 0.65rem 0 0;
		color: color-mix(in srgb, var(--menu-forest) 82%, transparent);
		font-size: 0.95rem;
		line-height: 1.65;
	}

	@media (min-width: 48rem) {
		.menu-intro {
			padding-block: clamp(4rem, 6vw, 5rem);
		}

		.menu-intro__inner {
			display: grid;
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: clamp(3rem, 6vw, 5rem);
			align-items: center;
		}

		.menu-intro__media {
			margin-top: 0;
		}

		.menu-category__heading--priced {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 2rem;
			align-items: end;
		}

		.menu-category__price {
			align-items: flex-end;
			margin-top: 0;
			text-align: right;
		}

		.menu-item {
			padding: 1.75rem 0;
		}
	}
</style>
