---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import gastronomyImage from '../assets/images/banquete_rBAstico_no_rancho.png';
import heroImage from '../assets/images/Terraço Rústico Sob as Árvores.png';
import ranchoImage from '../assets/images/Cerveja gelada no rancho rústico.png';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const suaVisitaUrl = `${baseUrl}/sua-visita`;
---

<BaseLayout
	title="Rancho Traviú"
	description="Site institucional do Rancho Traviú."
>
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero__inner">
			<div class="hero__content">
				<p class="hero__eyebrow">Natureza, tradição e acolhimento</p>
				<h1 id="hero-title">Rancho Traviú</h1>
				<p class="hero__description">
					Um lugar onde a natureza encontra a tradição e a comida ganha o
					sabor do fogão a lenha.
				</p>
			</div>

			<figure class="hero__media">
				<Image
					src={heroImage}
					alt="Imagem ilustrativa do ambiente principal do Rancho, com árvores, mesas ao ar livre e estrutura rústica acolhedora."
					class="hero__image"
					layout="full-width"
					sizes="(min-width: 80rem) 37rem, (min-width: 48rem) 46vw, calc(100vw - 2.5rem)"
					priority
				/>
			</figure>
		</div>
	</section>

	<section class="rancho" aria-labelledby="rancho-title">
		<div class="rancho__inner">
			<div class="rancho__content">
				<p class="rancho__eyebrow">O Rancho</p>
				<h2 id="rancho-title">Um lugar para aproveitar sem pressa.</h2>
				<p class="rancho__description">
					Entre árvores e mesas ao ar livre, o Rancho Traviú convida a
					aproveitar o ambiente com calma. A comida preparada no fogão a lenha
					completa essa experiência simples e tradicional.
				</p>
			</div>

			<figure class="rancho__media">
				<Image
					src={ranchoImage}
					alt="Imagem ilustrativa do ambiente do Rancho, com árvores, mesas ao ar livre e varanda de madeira em um clima acolhedor."
					class="rancho__image"
					layout="full-width"
					sizes="(min-width: 80rem) 36rem, (min-width: 48rem) 46vw, calc(100vw - 2.5rem)"
					loading="lazy"
				/>
			</figure>
		</div>
	</section>

	<section class="gastronomy" aria-labelledby="gastronomy-title">
		<div class="gastronomy__inner">
			<div class="gastronomy__content">
				<p class="gastronomy__eyebrow">Sabores do Rancho</p>
				<h2 id="gastronomy-title">O sabor do fogão a lenha</h2>
				<p class="gastronomy__description">
					O fogão a lenha e as panelas de barro fazem parte de um preparo que
					mantém viva a tradição da comida simples, feita com tempo e cuidado.
				</p>
			</div>

			<figure class="gastronomy__media">
				<Image
					src={gastronomyImage}
					alt="Cena ilustrativa de panelas de barro com comida sobre um fogão a lenha em ambiente ao ar livre."
					class="gastronomy__image"
					layout="full-width"
					sizes="(min-width: 80rem) 36rem, (min-width: 48rem) 46vw, calc(100vw - 2.5rem)"
					loading="lazy"
				/>
			</figure>
		</div>
	</section>

	<section class="visit-planning" aria-labelledby="visit-planning-title">
		<div class="visit-planning__inner">
			<div class="visit-planning__intro">
				<p class="visit-planning__eyebrow">Planeje sua visita</p>
				<h2 id="visit-planning-title">Seu próximo almoço no Rancho</h2>
				<p class="visit-planning__description">
					Organize sua visita e venha aproveitar um almoço em meio à natureza.
				</p>
			</div>

			<dl class="visit-planning__details">
				<div class="visit-planning__detail">
					<dt>Funcionamento</dt>
					<dd>Sábados, domingos e feriados.</dd>
				</div>
				<div class="visit-planning__detail">
					<dt>Horário</dt>
					<dd>Das 11h às 18h.</dd>
				</div>
			</dl>

			<a class="visit-planning__link" href={suaVisitaUrl}>
				Planeje sua visita
			</a>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		--hero-forest: #344b36;
		--hero-cream: #eee5d3;
		--hero-wood: #936544;

		display: grid;
		min-height: calc(100svh - 6.35rem);
		padding: clamp(2rem, 8vw, 3rem) 1.25rem
			clamp(3.5rem, 14vw, 5.5rem);
		align-items: start;
		background: var(--hero-cream);
		color: var(--hero-forest);
		font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
	}

	.hero__inner {
		display: grid;
		width: min(100%, 72rem);
		margin: 0 auto;
		gap: clamp(2.75rem, 10vw, 5rem);
		align-items: center;
	}

	.hero__content {
		max-width: 36rem;
	}

	.hero__eyebrow {
		margin: 0 0 1rem;
		color: #765033;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	h1 {
		max-width: 10ch;
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(3.25rem, 16vw, 6.75rem);
		font-weight: 400;
		letter-spacing: -0.055em;
		line-height: 0.9;
	}

	.hero__description {
		max-width: 33rem;
		margin: 1.75rem 0 0;
		font-size: clamp(1.05rem, 4vw, 1.3rem);
		line-height: 1.65;
	}

	.hero__media {
		position: relative;
		display: grid;
		width: 100%;
		aspect-ratio: 4 / 3;
		margin: 0;
		place-items: center;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--hero-forest) 35%, transparent);
		border-radius: 0.25rem 2rem 0.25rem 2rem;
		background: color-mix(in srgb, var(--hero-wood) 16%, var(--hero-cream));
		box-shadow: 0.75rem 0.75rem 0 var(--hero-forest);
	}

	.hero__media :global(.hero__image) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.rancho {
		--rancho-forest: #344b36;
		--rancho-cream: #eee5d3;
		--rancho-wood: #936544;

		padding: clamp(4rem, 12vw, 6rem) 1.25rem;
		border-top: 1px solid
			color-mix(in srgb, var(--rancho-wood) 30%, transparent);
		background: color-mix(
			in srgb,
			var(--rancho-forest) 5%,
			var(--rancho-cream)
		);
		color: var(--rancho-forest);
		font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
	}

	.rancho__inner {
		display: grid;
		width: min(100%, 72rem);
		margin: 0 auto;
		gap: clamp(2.5rem, 9vw, 4.5rem);
		align-items: center;
	}

	.rancho__content {
		max-width: 36rem;
	}

	.rancho__eyebrow {
		margin: 0 0 0.9rem;
		color: #765033;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.rancho h2 {
		max-width: 15ch;
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(2.25rem, 10vw, 4rem);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 1.05;
	}

	.rancho__description {
		max-width: 34rem;
		margin: 1.5rem 0 0;
		font-size: clamp(1rem, 3vw, 1.125rem);
		line-height: 1.7;
	}

	.rancho__media {
		position: relative;
		display: grid;
		width: 100%;
		aspect-ratio: 4 / 3;
		margin: 0;
		place-items: center;
		overflow: hidden;
		border: 1px solid
			color-mix(in srgb, var(--rancho-forest) 35%, transparent);
		border-radius: 1.5rem 0.25rem 1.5rem 0.25rem;
		background: color-mix(
			in srgb,
			var(--rancho-forest) 88%,
			var(--rancho-wood)
		);
	}

	.rancho__media :global(.rancho__image) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.gastronomy {
		--gastronomy-forest: #344b36;
		--gastronomy-cream: #eee5d3;
		--gastronomy-wood: #936544;
		--gastronomy-terracotta: #a65f46;

		padding: clamp(4rem, 12vw, 6rem) 1.25rem;
		border-top: 1px solid
			color-mix(in srgb, var(--gastronomy-terracotta) 35%, transparent);
		background: color-mix(
			in srgb,
			var(--gastronomy-wood) 16%,
			var(--gastronomy-cream)
		);
		color: var(--gastronomy-forest);
		font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
	}

	.gastronomy__inner {
		display: grid;
		width: min(100%, 72rem);
		margin: 0 auto;
		gap: clamp(2.5rem, 9vw, 4.5rem);
		align-items: center;
	}

	.gastronomy__content {
		max-width: 36rem;
	}

	.gastronomy__eyebrow {
		margin: 0 0 0.9rem;
		color: #765033;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.gastronomy h2 {
		max-width: 15ch;
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(2.25rem, 10vw, 4rem);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 1.05;
	}

	.gastronomy__description {
		max-width: 34rem;
		margin: 1.5rem 0 0;
		font-size: clamp(1rem, 3vw, 1.125rem);
		line-height: 1.7;
	}

	.gastronomy__media {
		position: relative;
		display: grid;
		width: 100%;
		aspect-ratio: 4 / 3;
		margin: 0;
		place-items: center;
		overflow: hidden;
		border: 1px solid
			color-mix(in srgb, var(--gastronomy-forest) 30%, transparent);
		border-radius: 0.25rem 1.5rem 0.25rem 1.5rem;
		background: color-mix(
			in srgb,
			var(--gastronomy-terracotta) 78%,
			var(--gastronomy-wood)
		);
	}

	.gastronomy__media :global(.gastronomy__image) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.visit-planning {
		--visit-planning-forest: #344b36;
		--visit-planning-cream: #eee5d3;
		--visit-planning-wood: #936544;
		--visit-planning-terracotta: #a65f46;

		padding: clamp(3.5rem, 10vw, 5rem) 1.25rem;
		border-top: 0.25rem solid var(--visit-planning-terracotta);
		background: color-mix(
			in srgb,
			var(--visit-planning-forest) 78%,
			var(--visit-planning-wood)
		);
		color: var(--visit-planning-cream);
		font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
	}

	.visit-planning__inner {
		display: grid;
		width: min(100%, 72rem);
		margin: 0 auto;
		gap: 2.25rem;
		align-items: center;
	}

	.visit-planning__intro {
		max-width: 34rem;
	}

	.visit-planning__eyebrow {
		margin: 0 0 0.75rem;
		color: color-mix(
			in srgb,
			var(--visit-planning-cream) 78%,
			var(--visit-planning-wood)
		);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.visit-planning h2 {
		max-width: 16ch;
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(2rem, 8vw, 3.25rem);
		font-weight: 400;
		letter-spacing: -0.03em;
		line-height: 1.05;
	}

	.visit-planning__description {
		max-width: 31rem;
		margin: 1.25rem 0 0;
		color: color-mix(
			in srgb,
			var(--visit-planning-cream) 82%,
			transparent
		);
		font-size: 1rem;
		line-height: 1.65;
	}

	.visit-planning__details {
		display: grid;
		margin: 0;
		gap: 1.25rem;
	}

	.visit-planning__detail {
		padding-top: 1rem;
		border-top: 1px solid
			color-mix(in srgb, var(--visit-planning-cream) 24%, transparent);
	}

	.visit-planning__detail dt {
		margin-bottom: 0.3rem;
		color: color-mix(
			in srgb,
			var(--visit-planning-cream) 72%,
			var(--visit-planning-wood)
		);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.visit-planning__detail dd {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.5;
	}

	.visit-planning__link {
		display: inline-flex;
		width: 100%;
		min-height: 2.75rem;
		padding: 0.8rem 1.25rem;
		align-items: center;
		justify-content: center;
		border: 0.125rem solid var(--visit-planning-cream);
		border-radius: 0.25rem;
		background: var(--visit-planning-cream);
		color: var(--visit-planning-forest);
		font-size: 0.9rem;
		font-weight: 700;
		line-height: 1.2;
		text-align: center;
		text-decoration: none;
	}

	.visit-planning__link:focus-visible {
		outline: 0.1875rem solid var(--visit-planning-cream);
		outline-offset: 0.25rem;
	}

	@media (hover: hover) {
		.visit-planning__link:hover {
			border-color: var(--visit-planning-wood);
			background: var(--visit-planning-wood);
			color: var(--visit-planning-cream);
		}
	}

	@media (min-width: 48rem) {
		.hero {
			min-height: auto;
			padding: clamp(3.5rem, 5vw, 5rem) clamp(2rem, 6vw, 6rem)
				clamp(4rem, 7vw, 7rem);
		}

		.hero__inner {
			grid-template-columns: minmax(0, 0.85fr) minmax(22rem, 1.15fr);
			gap: clamp(4rem, 8vw, 8rem);
			align-items: start;
		}

		.hero__media {
			aspect-ratio: 5 / 4;
		}

		.rancho {
			padding: clamp(5rem, 8vw, 8rem) clamp(2rem, 6vw, 6rem);
		}

		.rancho__inner {
			grid-template-columns: minmax(22rem, 1.1fr) minmax(0, 0.9fr);
			gap: clamp(4rem, 8vw, 7rem);
		}

		.rancho__content {
			grid-column: 2;
			grid-row: 1;
		}

		.rancho__media {
			grid-column: 1;
			grid-row: 1;
			aspect-ratio: 5 / 4;
		}

		.gastronomy {
			padding: clamp(5rem, 8vw, 8rem) clamp(2rem, 6vw, 6rem);
		}

		.gastronomy__inner {
			grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 1.1fr);
			gap: clamp(4rem, 8vw, 7rem);
		}

		.gastronomy__media {
			aspect-ratio: 5 / 4;
		}
	}

	@media (min-width: 56rem) {
		.visit-planning {
			padding: clamp(4rem, 6vw, 5.5rem) clamp(2rem, 6vw, 6rem);
		}

		.visit-planning__inner {
			grid-template-columns: minmax(0, 1.2fr) minmax(17rem, 0.8fr) auto;
			gap: clamp(2rem, 3vw, 3rem);
		}

		.visit-planning__details {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.5rem;
		}

		.visit-planning__detail {
			padding: 0 0 0 1.25rem;
			border-top: 0;
			border-left: 1px solid
				color-mix(in srgb, var(--visit-planning-cream) 24%, transparent);
		}

		.visit-planning__link {
			width: auto;
			white-space: nowrap;
		}
	}
</style>
