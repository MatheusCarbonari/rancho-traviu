---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
	title="Rancho Traviú"
	description="Site institucional do Rancho Traviú."
>
	<section class="hero" aria-labelledby="hero-title">
		<div class="hero__inner">
			<div class="hero__content">
				<p class="hero__eyebrow">Natureza, tradição e acolhimento</p>
				<h1 id="hero-title">Rancho Traviú</h1>
				<p class="hero__description">
					Um lugar onde a natureza encontra a tradição e a comida ganha o
					sabor do fogão a lenha.
				</p>
			</div>

			<figure class="hero__media">
				<div class="hero__placeholder">
					<span>Espaço reservado para a fotografia principal</span>
				</div>
				<figcaption>Imagem ilustrativa</figcaption>
			</figure>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		--hero-forest: #344b36;
		--hero-cream: #eee5d3;
		--hero-wood: #936544;

		display: grid;
		min-height: calc(100svh - 6.35rem);
		padding: clamp(2rem, 8vw, 3rem) 1.25rem
			clamp(3.5rem, 14vw, 5.5rem);
		align-items: start;
		background: var(--hero-cream);
		color: var(--hero-forest);
		font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
	}

	.hero__inner {
		display: grid;
		width: min(100%, 72rem);
		margin: 0 auto;
		gap: clamp(2.75rem, 10vw, 5rem);
		align-items: center;
	}

	.hero__content {
		max-width: 36rem;
	}

	.hero__eyebrow {
		margin: 0 0 1rem;
		color: var(--hero-wood);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	h1 {
		max-width: 10ch;
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(3.25rem, 16vw, 6.75rem);
		font-weight: 400;
		letter-spacing: -0.055em;
		line-height: 0.9;
	}

	.hero__description {
		max-width: 33rem;
		margin: 1.75rem 0 0;
		font-size: clamp(1.05rem, 4vw, 1.3rem);
		line-height: 1.65;
	}

	.hero__media {
		position: relative;
		display: grid;
		width: 100%;
		aspect-ratio: 4 / 3;
		margin: 0;
		place-items: center;
		border: 1px solid color-mix(in srgb, var(--hero-forest) 35%, transparent);
		border-radius: 0.25rem 2rem 0.25rem 2rem;
		background: color-mix(in srgb, var(--hero-wood) 16%, var(--hero-cream));
		box-shadow: 0.75rem 0.75rem 0 var(--hero-forest);
	}

	.hero__media::before {
		position: absolute;
		inset: 1rem;
		border: 1px solid color-mix(in srgb, var(--hero-forest) 24%, transparent);
		border-radius: 0.15rem 1.35rem 0.15rem 1.35rem;
		content: "";
	}

	.hero__placeholder {
		max-width: 16rem;
		padding: 2rem;
		text-align: center;
	}

	.hero__placeholder span {
		display: block;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	figcaption {
		position: absolute;
		right: 1.5rem;
		bottom: 1.5rem;
		padding: 0.45rem 0.65rem;
		background: var(--hero-cream);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	@media (min-width: 48rem) {
		.hero {
			min-height: calc(100svh - 5.25rem);
			padding: clamp(3.5rem, 5vw, 5rem) clamp(2rem, 6vw, 6rem)
				clamp(4rem, 7vw, 7rem);
		}

		.hero__inner {
			grid-template-columns: minmax(0, 0.85fr) minmax(22rem, 1.15fr);
			gap: clamp(4rem, 8vw, 8rem);
		}

		.hero__media {
			aspect-ratio: 5 / 4;
		}
	}
</style>
