---
import { Image } from 'astro:assets';
import ranchoEnvironmentImage from '../assets/images/Cerveja gelada no rancho rústico.png';
import galleryMainImage from '../assets/images/Pagina_Rancho_Geral.png';
import galleryTableImage from '../assets/images/Pagina_Rancho_Mesa.png';
import galleryStoveImage from '../assets/images/Pagina_Rancho_Fogao.png';
import BaseLayout from '../layouts/BaseLayout.astro';

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const suaVisitaUrl = `${baseUrl}/sua-visita`;
---

<BaseLayout
	title="O Rancho | Rancho Traviú"
	description="Conheça o ambiente simples do Rancho Traviú, entre árvores, mesas ao ar livre e comida preparada no fogão a lenha."
>
	<section class="rancho-intro" aria-labelledby="rancho-intro-title">
		<div class="rancho-intro__inner">
			<p class="rancho-intro__eyebrow">O Rancho</p>

			<h1 id="rancho-intro-title">Conheça o Rancho Traviú</h1>

			<div class="rancho-intro__description">
				<p>
					Em meio às árvores e com mesas ao ar livre, o Rancho Traviú reúne
					comida preparada no fogão a lenha, cerveja gelada e um ambiente
					descontraído para aproveitar sem pressa.
				</p>
			</div>
		</div>
	</section>

	<section class="outdoors" aria-labelledby="outdoors-title">
		<div class="outdoors__inner">
			<h2 id="outdoors-title">Entre árvores e boas conversas</h2>

			<figure class="outdoors__media">
				<Image
					src={ranchoEnvironmentImage}
					alt="Imagem ilustrativa do ambiente do Rancho, com árvores, mesas ao ar livre e uma varanda de madeira."
					class="outdoors__image"
					layout="full-width"
					loading="lazy"
				/>
				<figcaption>Imagem ilustrativa</figcaption>
			</figure>

			<div class="outdoors__description">
				<p>
					À sombra das árvores e entre mesas ao ar livre, o almoço ganha um
					ritmo tranquilo, com espaço para aproveitar a comida e as boas
					conversas.
				</p>
			</div>
		</div>
	</section>

	<section class="gallery" aria-labelledby="gallery-title">
		<div class="gallery__inner">
			<header class="gallery__intro">
				<h2 id="gallery-title">Momentos no Rancho</h2>
				<p>
					Uma prévia ilustrativa da atmosfera do Rancho: mesas entre árvores,
					comida no fogão a lenha e bons momentos.
				</p>
			</header>

			<div class="gallery__grid">
				<figure
					class="gallery__item gallery__item--main"
					aria-labelledby="gallery-main-caption"
				>
					<div class="gallery__media">
						<Image
							src={galleryMainImage}
							alt="Imagem ilustrativa da área geral do Rancho Traviú, com estrutura rústica, mesas ao ar livre e árvores ao redor."
							class="gallery__image"
							layout="full-width"
							loading="lazy"
						/>
						<span>Imagem ilustrativa</span>
					</div>
					<figcaption id="gallery-main-caption">Vista geral do Rancho</figcaption>
				</figure>

				<figure
					class="gallery__item gallery__item--photo"
					aria-labelledby="gallery-environment-caption"
				>
					<div class="gallery__media">
						<Image
							src={galleryTableImage}
							alt="Imagem ilustrativa de uma mesa servida no ambiente ao ar livre do Rancho, entre árvores e estruturas de madeira."
							class="gallery__image"
							layout="full-width"
							loading="lazy"
						/>
						<span>Imagem ilustrativa</span>
					</div>
					<figcaption id="gallery-environment-caption">
						Fotografia do ambiente
					</figcaption>
				</figure>

				<figure
					class="gallery__item gallery__item--photo"
					aria-labelledby="gallery-gastronomy-caption"
				>
					<div class="gallery__media">
						<Image
							src={galleryStoveImage}
							alt="Imagem ilustrativa de comida preparada em panelas de barro sobre o fogão a lenha do Rancho."
							class="gallery__image"
							layout="full-width"
							loading="lazy"
						/>
						<span>Imagem ilustrativa</span>
					</div>
					<figcaption id="gallery-gastronomy-caption">
						Fotografia da gastronomia
					</figcaption>
				</figure>
			</div>
		</div>
	</section>

	<section class="moments" aria-labelledby="moments-title">
		<div class="moments__inner">
			<div class="moments__intro">
				<h2 id="moments-title">Sabores e bons momentos</h2>
				<p>
					Venha aproveitar com calma os sabores e o ambiente descontraído do
					Rancho.
				</p>
			</div>

			<div class="moments__details">
				<ul aria-label="Destaques do Rancho">
					<li>Comida no fogão a lenha</li>
					<li>Cerveja gelada</li>
				</ul>

				<a class="moments__link" href={suaVisitaUrl}>Planeje sua visita</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.rancho-intro {
		--rancho-forest: #344b36;
		--rancho-cream: #eee5d3;
		--rancho-wood: #936544;
		--rancho-terracotta: #a65f46;

		padding: clamp(4rem, 12vw, 6rem) 1.25rem;
		background: color-mix(
			in srgb,
			var(--rancho-forest) 5%,
			var(--rancho-cream)
		);
		color: var(--rancho-forest);
		font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
	}

	.rancho-intro__inner {
		display: grid;
		width: min(100%, 72rem);
		margin: 0 auto;
		gap: 1.25rem;
	}

	.rancho-intro__eyebrow {
		margin: 0;
		color: var(--rancho-wood);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	h1 {
		max-width: 12ch;
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(2.75rem, 13vw, 5.5rem);
		font-weight: 400;
		letter-spacing: -0.045em;
		line-height: 0.98;
	}

	.rancho-intro__description {
		max-width: 36rem;
		margin-top: 1rem;
		padding: 1.25rem 0 0 1.25rem;
		border-top: 0.25rem solid var(--rancho-terracotta);
	}

	.rancho-intro__description p {
		margin: 0;
		font-size: clamp(1.05rem, 4vw, 1.2rem);
		line-height: 1.7;
	}

	.outdoors {
		--outdoors-forest: #344b36;
		--outdoors-cream: #eee5d3;
		--outdoors-wood: #936544;

		padding: clamp(4rem, 12vw, 6rem) 1.25rem;
		border-top: 1px solid
			color-mix(in srgb, var(--outdoors-wood) 30%, transparent);
		background: var(--outdoors-cream);
		color: var(--outdoors-forest);
		font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
	}

	.outdoors__inner {
		display: grid;
		width: min(100%, 72rem);
		margin: 0 auto;
		gap: 2rem;
	}

	.outdoors h2,
	.moments h2 {
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(2.25rem, 10vw, 4rem);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 1.05;
	}

	.outdoors h2 {
		max-width: 14ch;
	}

	.outdoors__media {
		position: relative;
		width: 100%;
		aspect-ratio: 4 / 3;
		margin: 0;
		overflow: hidden;
		border: 1px solid
			color-mix(in srgb, var(--outdoors-forest) 32%, transparent);
		border-radius: 0.25rem 1.5rem 0.25rem 1.5rem;
		background: color-mix(
			in srgb,
			var(--outdoors-forest) 14%,
			var(--outdoors-cream)
		);
	}

	.outdoors__media :global(.outdoors__image) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.outdoors__media figcaption {
		position: absolute;
		right: 1rem;
		bottom: 1rem;
		padding: 0.45rem 0.65rem;
		background: var(--outdoors-cream);
		color: var(--outdoors-forest);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1.4;
		text-transform: uppercase;
	}

	.outdoors__description {
		max-width: 34rem;
		padding-left: 1.25rem;
		border-left: 0.25rem solid var(--outdoors-wood);
	}

	.outdoors__description p {
		margin: 0;
		font-size: clamp(1rem, 3vw, 1.125rem);
		line-height: 1.7;
	}

	.gallery {
		--gallery-forest: #344b36;
		--gallery-cream: #eee5d3;
		--gallery-wood: #936544;
		--gallery-terracotta: #a65f46;

		padding: clamp(4rem, 12vw, 6rem) 1.25rem;
		border-top: 1px solid
			color-mix(in srgb, var(--gallery-wood) 30%, transparent);
		background: color-mix(
			in srgb,
			var(--gallery-forest) 6%,
			var(--gallery-cream)
		);
		color: var(--gallery-forest);
		font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
	}

	.gallery__inner {
		width: min(100%, 72rem);
		margin: 0 auto;
	}

	.gallery__intro {
		max-width: 42rem;
	}

	.gallery h2 {
		max-width: 14ch;
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: clamp(2.25rem, 10vw, 4rem);
		font-weight: 400;
		letter-spacing: -0.035em;
		line-height: 1.05;
	}

	.gallery__intro p {
		max-width: 36rem;
		margin: 1.25rem 0 0;
		font-size: clamp(1rem, 3vw, 1.125rem);
		line-height: 1.7;
	}

	.gallery__grid {
		display: grid;
		margin-top: clamp(2.5rem, 8vw, 4rem);
		gap: 1.75rem;
	}

	.gallery__item {
		margin: 0;
	}

	.gallery__media {
		position: relative;
		width: 100%;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border: 1px solid
			color-mix(in srgb, var(--gallery-forest) 28%, transparent);
		border-radius: 0.25rem 1.25rem 0.25rem 1.25rem;
		background: color-mix(
			in srgb,
			var(--gallery-wood) 14%,
			var(--gallery-cream)
		);
	}

	.gallery__item--main .gallery__media {
		aspect-ratio: 16 / 9;
	}

	.gallery__media :global(.gallery__image) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.gallery__media span {
		position: absolute;
		right: 1rem;
		bottom: 1rem;
		padding: 0.45rem 0.65rem;
		background: var(--gallery-cream);
		color: var(--gallery-forest);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.gallery__item figcaption {
		margin-top: 0.75rem;
		color: var(--gallery-wood);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		line-height: 1.5;
		text-transform: uppercase;
	}

	.moments {
		--moments-forest: #344b36;
		--moments-cream: #eee5d3;
		--moments-wood: #936544;
		--moments-terracotta: #a65f46;

		padding: clamp(3.5rem, 10vw, 5rem) 1.25rem;
		border-top: 1px solid
			color-mix(in srgb, var(--moments-terracotta) 38%, transparent);
		background: color-mix(
			in srgb,
			var(--moments-wood) 8%,
			var(--moments-cream)
		);
		color: var(--moments-forest);
		font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
			sans-serif;
	}

	.moments__inner {
		display: grid;
		width: min(100%, 72rem);
		margin: 0 auto;
		gap: 2.5rem;
	}

	.moments h2 {
		max-width: 15ch;
	}

	.moments__intro p {
		max-width: 32rem;
		margin: 1.25rem 0 0;
		color: color-mix(in srgb, var(--moments-forest) 88%, transparent);
		font-size: 1rem;
		line-height: 1.65;
	}

	.moments__details ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.moments__details li {
		padding: 1rem 0;
		border-top: 1px solid
			color-mix(in srgb, var(--moments-wood) 32%, transparent);
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.5;
	}

	.moments__details li::before {
		content: "";
		display: inline-block;
		width: 0.5rem;
		height: 0.5rem;
		margin-right: 0.75rem;
		border-radius: 50%;
		background: var(--moments-terracotta);
		vertical-align: 0.08rem;
	}

	.moments__link {
		display: inline-flex;
		width: 100%;
		min-height: 2.75rem;
		margin-top: 1.5rem;
		padding: 0.8rem 1.25rem;
		align-items: center;
		justify-content: center;
		border: 0.125rem solid var(--moments-forest);
		border-radius: 0.25rem;
		background: var(--moments-forest);
		color: var(--moments-cream);
		font-size: 0.9rem;
		font-weight: 700;
		line-height: 1.2;
		text-align: center;
		text-decoration: none;
	}

	.moments__link:focus-visible {
		outline: 0.1875rem solid var(--moments-terracotta);
		outline-offset: 0.25rem;
	}

	@media (hover: hover) {
		.moments__link:hover {
			border-color: var(--moments-wood);
			background: var(--moments-wood);
			color: var(--moments-cream);
		}
	}

	@media (min-width: 48rem) {
		.rancho-intro {
			padding: clamp(5rem, 8vw, 7rem) clamp(2rem, 6vw, 6rem);
		}

		.rancho-intro__inner {
			grid-template-columns: minmax(0, 1.15fr) minmax(20rem, 0.85fr);
			gap: 1.5rem clamp(4rem, 8vw, 7rem);
			align-items: end;
		}

		.rancho-intro__eyebrow {
			grid-column: 1 / -1;
		}

		.rancho-intro__description {
			margin: 0 0 0.4rem;
			padding: 0.5rem 0 0.5rem clamp(1.5rem, 3vw, 2.25rem);
			border-top: 0;
			border-left: 0.25rem solid var(--rancho-terracotta);
		}

		.outdoors {
			padding: clamp(5rem, 8vw, 8rem) clamp(2rem, 6vw, 6rem);
		}

		.outdoors__inner {
			grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.65fr);
			gap: clamp(2rem, 5vw, 4rem);
			align-items: end;
		}

		.outdoors h2 {
			grid-column: 1 / -1;
		}

		.outdoors__media {
			aspect-ratio: 3 / 2;
		}

		.outdoors__description {
			margin-bottom: 0.5rem;
			padding-left: clamp(1.5rem, 3vw, 2.25rem);
		}

		.gallery {
			padding: clamp(5rem, 8vw, 7rem) clamp(2rem, 6vw, 6rem);
		}

		.gallery__grid {
			grid-template-columns: minmax(0, 2.25fr) minmax(12rem, 1fr);
			gap: 1rem clamp(1.75rem, 3vw, 2.5rem);
			align-items: start;
		}

		.gallery__item--main {
			grid-row: 1 / span 2;
		}

		.gallery__item--photo .gallery__media {
			aspect-ratio: 16 / 9;
		}

		.moments {
			padding: clamp(4rem, 6vw, 5.5rem) clamp(2rem, 6vw, 6rem);
		}

		.moments__inner {
			grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr);
			gap: clamp(4rem, 8vw, 7rem);
			align-items: center;
		}

		.moments__link {
			width: auto;
		}
	}
</style>
